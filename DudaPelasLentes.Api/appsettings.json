{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "duda-pelas-lentes",
    "Audience": "duda-pelas-lentes",
    "ExpiresMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "storage/uploads",
    "PublicBasePath": "/media"
  },
  "Images": {
    "MaxUploadBytes": 15728640,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AllowedMimeTypes": [ "image/jpeg", "image/png", "image/webp" ],
    "Large": { "MaxWidth": 2000, "MaxHeight": 2000, "Quality": 82 },
    "Medium": { "MaxWidth": 1200, "MaxHeight": 1200, "Quality": 80 },
    "Thumb": { "MaxWidth": 500, "MaxHeight": 500, "Quality": 78 }
  }
}
